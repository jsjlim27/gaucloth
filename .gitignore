# ---- CMake build output ----
# Everything CMake generates lives here; regenerated by `cmake -B build`.
build/
build-*/
cmake-build-*/    # CLion's default build dirs

#CMake stray files if anyone configures in-source (they shouldn't, but just in case)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!CMakelists.txt    # but DO keep the one file we actually wrote


# ---- Compiled output ----
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe
gaucloth    # the built executable, if it ever lands at the root


# ---- FetchContent downloads ----
# GLFW source is pulled into build/_deps (already covered by build/), but
# if you ever relocate the deps cahce, ignore it here too.
_deps/

# ---- EDITOR / IDE ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS junk ----
.DS_Store
Thumbs.db
